# Ключ из https://dvor-play.ru/cabinet/profile/api-key
# В GitHub Actions: repository secret DVOR_API_KEY (admin-ключ для publish)
DVOR_API_KEY=

# По умолчанию https://dvor-play.ru/main-api
# DVOR_API_URL=https://dvor-play.ru/main-api

# true — сразу на модерацию / publish (admin) после upload (по умолчанию true)
# DVOR_SUBMIT=true

# Метка версии zip; если пусто — package.json#version, иначе timestamp
# В CI всегда используется package.json#version (пользовательская метка)
# DVOR_VERSION=

# DVOR_SKIP_BUILD=true
