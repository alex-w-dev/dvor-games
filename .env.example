# Ключ из https://dvor-play.ru/cabinet/profile/api-key
# В GitHub Actions: repository secret DVOR_API_KEY (admin-ключ для publish)
DVOR_API_KEY=

# По умолчанию https://dvor-play.ru/main-api
# DVOR_API_URL=https://dvor-play.ru/main-api

# true — сразу на модерацию / publish (admin) после upload (по умолчанию true)
# DVOR_SUBMIT=true

# Метка версии; если пусто — package.json#version (обязательна: цифры и точки, напр. 0.1.2)
# В CI всегда используется package.json#version
# DVOR_VERSION=

# DVOR_SKIP_BUILD=true

# Только медиа/card без zip (нужны dvor.icon / dvor.card и т.п.)
# DVOR_CARD_ONLY=true

# Оверрайды путей к PNG (иначе package.json#dvor.icon / cover / coverShowcase)
# DVOR_ICON=assets/icon-512.png
# DVOR_COVER=
# DVOR_COVER_SHOWCASE=
