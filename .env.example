# Ключ из https://lightborn.ru/cabinet/profile/api-key
# В GitHub Actions: repository secret LIGHTBORN_API_KEY (admin-ключ для publish)
LIGHTBORN_API_KEY=

# По умолчанию https://lightborn.ru/main-api
# LIGHTBORN_API_URL=https://lightborn.ru/main-api

# true — сразу на модерацию / publish (admin) после upload (по умолчанию true)
# LIGHTBORN_SUBMIT=true

# Метка версии zip; если пусто — package.json#version, иначе timestamp
# В CI всегда используется package.json#version (пользовательская метка)
# LIGHTBORN_VERSION=

# LIGHTBORN_SKIP_BUILD=true
